    "SEED_NUM = 4   # change if your last digit is different\n",
    "STUDENT_MAJOR = \"BSME\"\n",
    "FAVORITE_ARTIST = \"LANA DEL REY\"\n",
    "LOCAL_HAZARD = \"FLOOD\"\n",
    "\n",
    "CONTROL_NUM = max(3, SEED_NUM)"
   ]
